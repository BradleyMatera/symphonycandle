<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ page_title | escape }}{% unless page_title contains shop.name %} · {{ shop.name | escape }}{% endunless %}</title>
{{ content_for_header }}
{{ 'studio-theme.css' | asset_url | stylesheet_tag }}
{% assign texture_file = 'concept-' | append: settings.concept | append: '-texture.png' %}
<style>:root{--bg:{{ settings.background }};--ink:{{ settings.foreground }};--accent:{{ settings.accent }};--surface:url('{{ texture_file | asset_url }}')}</style>
</head><body class="theme-{{ settings.concept | escape }}">
<a href="#MainContent" class="skip">Skip to content</a>
{% section 'site-header' %}
<main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
{% section 'site-footer' %}
<script src="{{ 'studio-theme.js' | asset_url }}" defer></script>
</body></html>