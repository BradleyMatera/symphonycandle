<section class="section container"><h1 class="page-title">Search</h1><form action="{{ routes.search_url }}" method="get" role="search"><label class="field" for="SearchInput">Search products<input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Find something beautiful"></label><input type="hidden" name="type" value="product"><button type="submit">Search</button></form>{% if search.performed %}<h2>Results for “{{ search.terms | escape }}”</h2>{% paginate search.results by 24 %}<div class="cards">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'studio-product-card', product: item %}{% endif %}{% else %}<p>No results found.</p>{% endfor %}</div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}{% endif %}</section>{% schema %}{"name":"Search results","settings":[]} {% endschema %}