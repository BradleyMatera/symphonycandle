<section class="section container"><h1 class="page-title">{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div>{{ collection.description }}</div>{% endif %}{% paginate collection.products by 24 %}<div class="cards">{% for product in collection.products %}{% render 'studio-product-card', product: product %}{% else %}<p>No products in this collection yet.</p>{% endfor %}</div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}</section>{% schema %}{"name":"Collection products","settings":[]} {% endschema %}