<section class="section container"><h1 class="page-title">Your cart</h1>{% if cart.item_count == 0 %}<p>Your cart is empty.</p><a class="btn" href="{{ routes.all_products_collection_url }}">Continue shopping</a>{% else %}<form action="{{ routes.cart_url }}" method="post"><table class="cart-table"><thead><tr><th>Product</th><th>Price</th><th>Qty</th><th>Total</th></tr></thead><tbody>{% for item in cart.items %}<tr><td><a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 180 | image_tag: class: 'cart-thumb' }}{% endif %}{{ item.product.title | escape }} · {{ item.variant.title | escape }}</a></td><td>{{ item.final_price | money }}</td><td><input type="number" min="0" name="updates[]" value="{{ item.quantity }}" aria-label="Quantity for {{ item.product.title | escape }}"></td><td>{{ item.final_line_price | money }}</td></tr>{% endfor %}</tbody></table><h2>Subtotal: {{ cart.total_price | money }}</h2><p>Taxes and shipping calculated at checkout.</p><button type="submit" name="update">Update cart</button> <button type="submit" name="checkout">Checkout securely</button></form>{% endif %}</section>{% schema %}{"name":"Cart","settings":[]} {% endschema %}