<section class="section section-texture"><div class="container hero-grid"><div><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.text | escape }}</p>{% if section.settings.link != blank %}<a class="btn" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>{% endif %}</div><div>{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '400,750,1100,1400', alt: section.settings.heading }}{% else %}<div class="empty">Select a hero photograph in the theme editor</div>{% endif %}</div></div></section>
{% schema %}{"name":"Studio hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Symphony Bath & Candle"},{"type":"text","id":"heading","label":"Heading","default":"Made with intention."},{"type":"textarea","id":"text","label":"Description","default":"Handmade products made with care to engage the senses."},{"type":"image_picker","id":"image","label":"Hero image"},{"type":"url","id":"link","label":"Link"},{"type":"text","id":"link_label","label":"Button","default":"Discover the collection"}],"presets":[{"name":"Studio hero"}]}{% endschema %}