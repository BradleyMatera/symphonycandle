<header class="head"><div class="container"><a href="{{ routes.root_url }}" class="logo">{{ shop.name | escape }}</a><nav class="nav" aria-label="Main menu">{% for link in linklists[section.settings.menu].links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}</nav><div class="header-tools"><a href="{{ routes.search_url }}">Search</a><a href="{{ routes.cart_url }}">Cart ({{ cart.item_count }})</a></div></div></header>
{% schema %}{"name":"Store header","settings":[{"type":"link_list","id":"menu","label":"Navigation menu","default":"main-menu"}]}{% endschema %}