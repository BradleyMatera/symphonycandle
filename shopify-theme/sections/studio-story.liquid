<section class="section section-texture"><div class="container story"><div>{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '450,750,1200' }}{% endif %}</div><div><span class="eyebrow">{{ section.settings.kicker | escape }}</span><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p>{% if section.settings.link != blank %}<a class="btn" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>{% endif %}</div></div></section>
{% schema %}{"name":"Brand story","settings":[{"type":"image_picker","id":"image","label":"Story photo"},{"type":"text","id":"kicker","label":"Eyebrow","default":"Behind the brand"},{"type":"text","id":"heading","label":"Heading","default":"A composition of handmade goods."},{"type":"textarea","id":"text","label":"Body text","default":"Made with care to engage the senses."},{"type":"url","id":"link","label":"Link"},{"type":"text","id":"link_label","label":"Button label","default":"Learn more"}],"presets":[{"name":"Brand story"}]}{% endschema %}