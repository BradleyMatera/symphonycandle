<section class="container product-grid"><div class="product-gallery">{% for media in product.media %}{% if media.media_type == 'image' %}{{ media | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400,750,1100,1400' }}{% else %}{{ media | media_tag }}{% endif %}{% endfor %}</div><div><span class="eyebrow">{{ product.vendor | escape }}</span><h1 class="page-title">{{ product.title | escape }}</h1><p class="price">{{ product.price | money }}</p><div>{{ product.description }}</div>{% form 'product', product %}{{ form | payment_terms }}<div class="field"><label for="ProductVariant">Choose option</label><select name="id" id="ProductVariant">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} · Sold out{% endunless %}</option>{% endfor %}</select></div><div class="field"><label for="ProductQuantity">Quantity</label><input id="ProductQuantity" type="number" name="quantity" min="1" value="1"></div><button type="submit" name="add" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to cart{% else %}Sold out{% endif %}</button>{% endform %}</div></section>
{% schema %}{"name":"Product information","settings":[]} {% endschema %}