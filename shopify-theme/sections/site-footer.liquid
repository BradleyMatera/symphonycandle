<footer class="footer"><div class="container footer-grid"><div><h2>{{ shop.name | escape }}</h2><p>{{ section.settings.text | escape }}</p></div><div><a href="{{ routes.search_url }}">Search</a><br><a href="{{ routes.cart_url }}">Your cart</a><br>{% for link in linklists[section.settings.menu].links %}<a href="{{ link.url }}">{{ link.title | escape }}</a><br>{% endfor %}</div></div></footer>{% schema %}{"name":"Store footer","settings":[{"type":"text","id":"text","label":"Footer copy","default":"Handmade products and thoughtful gifts."},{"type":"link_list","id":"menu","label":"Footer links","default":"footer"}]}{% endschema %}