<section class="section"><div class="container"><span class="eyebrow">{{ section.settings.kicker | escape }}</span><h2>{{ section.settings.heading | escape }}</h2>{% assign featured = collections[section.settings.collection] %}{% if featured != blank and featured.products_count > 0 %}<div class="cards">{% for product in featured.products limit: section.settings.count %}{% render 'studio-product-card', product: product %}{% endfor %}</div>{% else %}<p class="empty">Select a published collection in the theme editor to show real purchasable products.</p>{% endif %}</div></section>
{% schema %}{"name":"Featured products","settings":[{"type":"text","id":"kicker","label":"Eyebrow","default":"Explore the collection"},{"type":"text","id":"heading","label":"Heading","default":"From the studio"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"count","label":"Number of products","min":3,"max":12,"step":1,"default":6}],"presets":[{"name":"Featured products"}]}{% endschema %}