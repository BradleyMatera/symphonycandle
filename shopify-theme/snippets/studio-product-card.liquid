<article class="card"><a href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | image_tag: class: 'card-img', loading: 'lazy', widths: '280,480,800' }}{% else %}<div class="card-img empty">Image coming soon</div>{% endif %}<h3>{{ product.title | escape }}</h3><p class="price">{{ product.price | money }}{% unless product.available %} · Sold out{% endunless %}</p></a></article>